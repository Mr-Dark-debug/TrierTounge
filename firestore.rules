rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /temp_verification/{docId} {
      allow read, write: if true;
    }
    
    // 2. Chat & Matches
    match /matches/{matchId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
      match /typing/{userId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // 3. Events System
    match /events/{eventId} {
      allow read, write: if request.auth != null;
      match /comments/{commentId} {
        allow read, write: if request.auth != null;
      }
    }

    // 👇 NEW: Discovery & Match Engine 👇
    match /swipes/{swipeId} {
      allow read, write: if request.auth != null;
    }

    // 👇 NEW: Real-Time Notifications 👇
    match /notifications/{notificationId} {
      // Users can only read their own notifications, but anyone can send them
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow write: if request.auth != null;
    }

    // 👇 NEW: System Announcements 👇
    match /system_announcements/{announcementId} {
      allow read: if request.auth != null; // Everyone can read announcements
      allow write: if false; // Only admins can write announcements (via Firebase Console)
    }
  }
}
